DB_NAME=alanan
DB_USERNAME=alanan_app
DB_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
DB_PORT=5432
# Optional external JDBC URL. Setting it skips local Docker database startup.
# DB_URL=jdbc:postgresql://YOUR_NEON_HOST:5432/neondb?sslmode=require&channelBinding=require
JWT_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES

# Backend HTTP port; also used by the frontend development proxy.
SERVER_PORT=8080
