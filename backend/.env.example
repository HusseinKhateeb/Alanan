# Export these variables in your shell/IDE. Spring does not load this file automatically.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alanan
DB_USERNAME=alanan_app
DB_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
# Enable only for the first startup of an empty database; remove these afterward.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
