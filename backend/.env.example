# Export these variables in your shell/IDE. Spring does not load this file automatically.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alanan
DB_USERNAME=alanan_app
DB_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
# Optional external JDBC URL; keep username/password in the variables above.
# Use the direct Neon host (without -pooler) for this backend.
# DB_URL=jdbc:postgresql://YOUR_DIRECT_NEON_HOST:5432/neondb?sslmode=require&channelBinding=require
# BACKUP_STAGING_DIRECTORY=./backups/staged
# PG_DUMP_COMMAND=pg_dump
# PG_RESTORE_COMMAND=pg_restore
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
# Optional local development provisioning; creates the named admin only if absent.
# Keep the password in the ignored root .env, never in tracked templates or source.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
